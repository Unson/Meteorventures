---
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { Head } from "@/components/Head";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

import HomePage from "@/components/pages/HomePage";
import AboutPage from "@/components/pages/AboutPage";
import ServicesPage from "@/components/pages/ServicesPage";
import InsightsPage from "@/components/pages/InsightsPage";
import InsightDetailPage from "@/components/pages/InsightDetailPage";
import FreeAuditPage from "@/components/pages/FreeAuditPage";
import ContactPage from "@/components/pages/ContactPage";
import PartnersPage from "@/components/pages/PartnersPage";
import TransmissionsPage from "@/components/pages/TransmissionsPage";

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const segments = pathname.split('/').filter(Boolean);

// Determine which page to render and the page name for SEO
let PageComponent = HomePage;
let pageName = 'Home';

if (segments[0] === 'about') {
  PageComponent = AboutPage;
  pageName = 'About';
} else if (segments[0] === 'services') {
  PageComponent = ServicesPage;
  pageName = 'Services';
} else if (segments[0] === 'insights' && segments[1]) {
  PageComponent = InsightDetailPage;
  pageName = 'Insight';
} else if (segments[0] === 'insights') {
  PageComponent = InsightsPage;
  pageName = 'Insights';
} else if (segments[0] === 'free-audit') {
  PageComponent = FreeAuditPage;
  pageName = 'Free Audit';
} else if (segments[0] === 'contact') {
  PageComponent = ContactPage;
  pageName = 'Contact';
} else if (segments[0] === 'partners') {
  PageComponent = PartnersPage;
  pageName = 'Partners';
} else if (segments[0] === 'transmissions') {
  PageComponent = TransmissionsPage;
  pageName = 'Transmissions';
}

const seoTagsServiceConfig = await loadSEOTagsServiceConfig({
  pageUrl: Astro.url.href,
  itemData: {
    pageName,
  },
});
---
<html lang="en" class="w-full h-full">
  <head>
    <Head />
    <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <PageComponent client:only="react" />
    </div>
  </body>
</html>
